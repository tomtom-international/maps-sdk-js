{
  "name": "@tomtom-org/maps-sdk",
  "author": "TomTom International B.V.",
  "license": "See in LICENSE.txt",
  "version": "0.55.1",
  "description": "TomTom maps, search, geocoding, routing, isochrones, EV and traffic for JavaScript — typed GeoJSON services and a MapLibre GL JS map.",
  "homepage": "https://docs.tomtom.com/maps-sdk-js/introduction/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomtom-international/maps-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/tomtom-international/maps-sdk-js/issues"
  },
  "scripts": {
    "build": "pnpm build:sdk",
    "build:api-reference": "nx run @tomtom-org/maps-sdk:typedoc",
    "build:examples": "nx run-many -t build -p '@examples/*' --parallel=8 && nx run @tomtom-org/maps-sdk-examples:build",
    "build:examples:sandpack": "nx run-many -t build:sandpack -p '@examples/*' --parallel=8",
    "build:sdk": "nx run-many -t build -p core services map && pnpm build:third-party",
    "build:third-party": "node shared-configs/aggregateThirdParty.ts",
    "build:third-party:plugins": "node shared-configs/aggregateThirdParty.ts --plugins",
    "prepare": "pnpm build:third-party --best-effort && pnpm build:third-party:plugins --best-effort",
    "eval:explorer": "pnpm -F @testing/ai-eval-explorer dev",
    "eval:explorer:build": "nx run @testing/ai-eval-explorer:build",
    "build:agent-eval": "nx run agent-eval:build",
    "build:plugins": "nx run-many -t build -p '@tomtom-org/maps-sdk-plugin-*' && pnpm build:third-party:plugins",
    "clean": "pnpm -r --no-bail clean:dist && pnpm -r --no-bail clean:cache && nx reset",
    "e2e-test:agent-toolkit:sandbox": "nx run @tomtom-org/maps-sdk-plugin-agent-toolkit:test:e2e",
    "e2e-test:examples": "nx run @tomtom-org/maps-sdk-examples:test:e2e",
    "e2e-test:examples:sandpack": "nx run @tomtom-org/maps-sdk-examples:test:e2e:sandpack",
    "e2e-test:examples:prod": "nx run @tomtom-org/maps-sdk-examples:test:e2e:prod",
    "eval-test:examples": "nx run @tomtom-org/maps-sdk-examples:test:eval",
    "e2e-test:examples:update-all-snapshots": "pnpm -F @tomtom-org/maps-sdk-examples test:e2e:update-all-snapshots",
    "e2e-test:examples:update-snapshot": "pnpm -F @tomtom-org/maps-sdk-examples test:e2e:update-snapshot",
    "e2e-test:sdk": "nx run map-integration-tests:test:e2e",
    "generate-thumbnails:examples": "pnpm -F @tomtom-org/maps-sdk-examples generate-thumbnails",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write && biome lint . --write",
    "agent-tool-calling-test:agent-toolkit": "nx run @tomtom-org/maps-sdk-plugin-agent-toolkit:test:agent-tool-calling",
    "agent-tool-calling-test:examples": "nx run-many -t test:agent-tool-calling -p '@examples/*' --parallel=1",
    "sync-docs-package-version": "bash documentation/scripts/update-sdk-version-in-docs.sh",
    "sync-examples-package-version": "bash examples/scripts/sync-examples-package-version.sh",
    "test:agent-eval": "nx run agent-eval:test",
    "test:sdk": "nx run-many -t test -p shared-configs core services map",
    "test:sdk:coverage": "nx run-many -t test:coverage -p shared-configs core services map '@tomtom-org/maps-sdk-plugin-*'",
    "test:plugins": "nx run-many -t test -p '@tomtom-org/maps-sdk-plugin-*'",
    "test:examples": "nx run @tomtom-org/maps-sdk-examples:test",
    "type-check:examples": "nx run-many -t type-check -p '@examples/*'",
    "type-check:plugins": "nx run-many -t type-check -p '@tomtom-org/maps-sdk-plugin-*'",
    "type-check:sdk": "nx run-many -t type-check -p core services map map-integration-tests"
  },
  "keywords": [
    "tomtom",
    "sdk",
    "api",
    "map",
    "location",
    "search",
    "geocoding",
    "routing",
    "traffic",
    "web",
    "nodejs",
    "maplibre",
    "maplibre-gl",
    "geojson",
    "typescript",
    "directions",
    "reverse-geocoding",
    "autocomplete",
    "poi",
    "isochrone",
    "ev-charging",
    "navigation"
  ],
  "nx": {
    "includedScripts": []
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@size-limit/file": "^13.0.3",
    "@size-limit/preset-app": "^13.0.3",
    "nx": "22.7.12",
    "size-limit": "^13.0.3",
    "typedoc": "^0.28.20",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@turf/turf": "catalog:",
    "lodash-es": "catalog:",
    "maplibre-gl": "catalog:",
    "zod": "catalog:"
  },
  "size-limit": [
    {
      "path": "services/dist/services*.js"
    },
    {
      "path": "core/dist/core*.js"
    },
    {
      "path": "map/dist/map*.js"
    }
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.13.1",
  "files": [
    "core/dist",
    "core/package.json",
    "map/dist",
    "map/package.json",
    "services/dist",
    "services/package.json",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "THIRD_PARTY.txt"
  ],
  "exports": {
    "./core": {
      "types": "./core/dist/index.d.ts",
      "default": "./core/dist/core.es.js"
    },
    "./services": {
      "types": "./services/dist/index.d.ts",
      "default": "./services/dist/services.es.js"
    },
    "./map": {
      "types": "./map/dist/index.d.ts",
      "default": "./map/dist/map.es.js"
    }
  }
}
