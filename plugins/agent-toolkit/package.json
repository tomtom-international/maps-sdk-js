{
  "name": "@tomtom-org/maps-sdk-plugin-agent-toolkit",
  "author": "TomTom International B.V.",
  "license": "See in LICENSE.txt",
  "version": "0.2.12",
  "type": "module",
  "description": "Agent toolkit plugin for TomTom Maps SDK JS using Vercel AI SDK",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build --config ../plugin-vite-config.ts",
    "build:watch": "vite build --watch --config ../plugin-vite-config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenarios": "vitest run src/tests/scenarios",
    "test:scenarios:full": "cross-env SCENARIOS_FULL=1 vitest run src/tests/scenarios",
    "test:scenarios:watch": "vitest src/tests/scenarios"
  },
  "peerDependencies": {
    "@tomtom-org/maps-sdk": "workspace:*",
    "@turf/turf": "catalog:",
    "ai": "catalog:",
    "chart.js": "catalog:",
    "h3-js": "catalog:",
    "maplibre-gl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/azure": "catalog:",
    "@langwatch/scenario": "^0.4.11",
    "@microsoft/api-extractor": "catalog:",
    "@tsconfig/recommended": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "^10.1.0",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.es.js"
    }
  }
}
