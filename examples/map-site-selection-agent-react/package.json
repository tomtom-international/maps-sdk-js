{
  "name": "@examples/map-site-selection-agent-react",
  "description": "TomTom Maps SDK Agent Toolkit React site-selection agent with Azure OpenAI",
  "type": "module",
  "scripts": {
    "build": "vite build --config ./vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ./vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run src/tests/unit",
    "test:unit:coverage": "vitest run --coverage src/tests/unit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server:prod": "vite preview --port 9050"
  },
  "dependencies": {
    "@ai-sdk/azure": "catalog:",
    "@ai-sdk/react": "catalog:",
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-ai-sdk": "catalog:",
    "@microsoft/applicationinsights-web": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@tomtom-org/maps-sdk": "catalog:",
    "@tomtom-org/maps-sdk-plugin-agent-toolkit": "catalog:",
    "@turf/turf": "catalog:",
    "ai": "catalog:",
    "assistant-stream": "catalog:",
    "chart.js": "catalog:",
    "chartjs-plugin-zoom": "catalog:",
    "lucide-react": "catalog:",
    "marked": "catalog:",
    "react": "catalog:",
    "react-chartjs-2": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "maplibre-gl": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
