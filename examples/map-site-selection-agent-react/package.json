{
  "name": "@examples/map-site-selection-agent-react",
  "description": "TomTom Maps SDK Agent Toolkit React conversational map agent (plain base) with Azure OpenAI",
  "type": "module",
  "scripts": {
    "build": "vite build --config ./vite.config.ts",
    "build:sandpack": "vite build --config ../example-sandpack-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ./vite.config.ts",
    "develop:sandpack": "vite --config ../example-sandpack-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run src/tests/unit",
    "test:unit:coverage": "vitest run --coverage src/tests/unit",
    "test:agent-tool-calling": "vitest run --config vitest.scenarios.config.ts src/tests/scenarios",
    "test:agent-tool-calling:full": "cross-env SCENARIOS_FULL=1 vitest run --config vitest.scenarios.config.ts src/tests/scenarios",
    "test:agent-tool-calling:watch": "vitest --config vitest.scenarios.config.ts src/tests/scenarios",
    "test": "vitest run --exclude 'src/tests/**'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server:prod": "vite preview --port 9050",
    "start-test-server:sandpack": "vite preview --config ../example-sandpack-vite.config.ts --port 9051"
  },
  "dependencies": {
    "@ai-sdk/azure": "catalog:",
    "@ai-sdk/react": "^3.0.158",
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-ai-sdk": "catalog:",
    "@assistant-ui/react-markdown": "catalog:",
    "@assistant-ui/react-ui": "^0.2.1",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@tomtom-org/maps-sdk": "workspace:*",
    "@tomtom-org/maps-sdk-plugin-agent-toolkit": "workspace:*",
    "@turf/turf": "catalog:",
    "ai": "catalog:",
    "assistant-stream": "catalog:",
    "chart.js": "catalog:",
    "chartjs-plugin-zoom": "catalog:",
    "marked": "catalog:",
    "react": "catalog:",
    "react-chartjs-2": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@langwatch/scenario": "^0.4.11",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing/agent-tool-calling": "workspace:*",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "agent-eval": "workspace:*",
    "cross-env": "^10.1.0",
    "maplibre-gl": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "tailwindcss": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
