{
  "name": "@examples/feature-event-states",
  "description": "Triangles drawn with the CustomGeoJSONModule, coloured by their hover, recently-hovered and click event states",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server:prod": "vite serve dist/prod --port 9050"
  },
  "dependencies": {
    "@tomtom-org/maps-sdk": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
