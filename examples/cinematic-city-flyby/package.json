{
  "name": "@examples/cinematic-city-flyby",
  "description": "Example flying a looping bird's-eye camera round landmarks and down famous streets, banking into the turns, in eight cities and eighteen themes mixing 3D buildings, map effects with their own GPU passes, and map-theme colours.",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server:prod": "vite serve dist/prod --port 9050"
  },
  "dependencies": {
    "@tomtom-org/maps-sdk": "catalog:",
    "@tomtom-org/maps-sdk-plugin-landmarks-3d": "catalog:",
    "@tomtom-org/maps-sdk-plugin-map-effects": "catalog:",
    "@tomtom-org/maps-sdk-plugin-map-theme": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
