# Create an .env file in current directory and set values for the local development
API_KEY_EXAMPLES=

# Required for the agent examples
AZURE_API_KEY=
AZURE_DEPLOYMENT_ID=
AZURE_RESOURCE_NAME=

# Required for traffic area analytics (Move Portal key)
MOVE_PORTAL_KEY=

# Demos-proxy mode, for TomTom's hosted demos. When both are set at BUILD TIME,
# the example builds inject a bootstrap that establishes a session cookie and
# points the SDK's commonBaseURL at the demos proxy. Leave them empty for local
# development: `pnpm develop` uses API_KEY_EXAMPLES.
DEMOS_PROXY_URL=
HCAPTCHA_SITEKEY=
