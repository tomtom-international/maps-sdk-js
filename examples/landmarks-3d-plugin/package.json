{
  "name": "@examples/landmarks-3d-plugin",
  "description": "Render TomTom Orbis 3D Landmarks on a TomTomMap with the Landmarks 3D plugin",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --grep @prod",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:update-snapshots:prod": "playwright test --update-snapshots --grep @prod",
    "start-test-server:prod": "vite serve dist/prod --port 9050"
  },
  "dependencies": {
    "@tomtom-org/maps-sdk": "catalog:",
    "@tomtom-org/maps-sdk-plugin-landmarks-3d": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
