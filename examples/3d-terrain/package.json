{
  "name": "@examples/3d-terrain",
  "description": "Render the map surface in 3D using terrain elevation data",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "build:sandpack": "vite build --config ../example-sandpack-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "develop:sandpack": "vite --config ../example-sandpack-vite.config.ts",
    "start-test-server:prod": "vite serve dist/prod --port 9050",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --grep @prod",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:update-snapshots:prod": "playwright test --update-snapshots --grep @prod",
    "type-check": "tsc --noEmit",
    "start-test-server:sandpack": "vite preview --outDir dist/sandpack --port 9051"
  },
  "dependencies": {
    "@tomtom-org/maps-sdk": "workspace:*",
    "@tomtom-org/maps-sdk-plugin-landmarks-3d": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
