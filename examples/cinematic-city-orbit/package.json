{
  "name": "@examples/cinematic-city-orbit",
  "description": "Example orbiting a landmark in a busy city, mixing the Landmarks 3D plugin's landmarks and buildings, the map effects plugin's bloom and depth of field, and map-theme colours, in looks picked from presets.",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server:prod": "vite serve dist/prod --port 9050"
  },
  "dependencies": {
    "@tomtom-org/maps-sdk": "catalog:",
    "@tomtom-org/maps-sdk-plugin-landmarks-3d": "catalog:",
    "@tomtom-org/maps-sdk-plugin-map-effects": "catalog:",
    "@tomtom-org/maps-sdk-plugin-map-theme": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
