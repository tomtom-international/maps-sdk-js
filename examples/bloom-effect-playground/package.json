{
  "name": "@examples/bloom-effect-playground",
  "description": "Example: every bloom knob on one panel, including the colour scope that decides what may glow.",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "start-test-server": "vite preview --port 9050 --outDir dist/prod",
    "start-test-server:prod": "vite preview --port 9050 --outDir dist/prod",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --grep @prod",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:update-snapshots:prod": "playwright test --update-snapshots --grep @prod",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tomtom-org/maps-sdk": "catalog:",
    "@tomtom-org/maps-sdk-plugin-map-effects": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
