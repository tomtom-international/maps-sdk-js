{
  "name": "@examples/map-traffic-agent-react",
  "description": "TomTom Maps SDK Agent Toolkit React traffic-manager example with Azure OpenAI",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "develop:sandpack": "vite --config ../example-sandpack-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server": "vite preview --port 9050"
  },
  "dependencies": {
    "@ai-sdk/azure": "catalog:",
    "@ai-sdk/react": "^3.0.158",
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-ai-sdk": "^1.3.18",
    "@assistant-ui/react-markdown": "^0.12.8",
    "@assistant-ui/react-ui": "^0.2.1",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@tomtom-org/maps-sdk": "workspace:*",
    "@tomtom-org/maps-sdk-plugin-agent-toolkit": "workspace:*",
    "ai": "catalog:",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "h3-js": "^4.4.0",
    "marked": "catalog:",
    "react": "catalog:",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "maplibre-gl": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
