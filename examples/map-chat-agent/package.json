{
  "name": "@examples/map-chat-agent",
  "description": "Map chat agent example with Azure OpenAI",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "develop:sandpack": "vite --config ../example-sandpack-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server": "vite preview --port 9050"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.27",
    "@tomtom-org/maps-sdk": "workspace:*",
    "@tomtom-org/maps-sdk-map-agent": "workspace:*",
    "ai": "6.0.78",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "maplibre-gl": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
