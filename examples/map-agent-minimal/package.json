{
  "name": "@examples/map-agent-minimal",
  "description": "Minimal map agent in plain TypeScript",
  "type": "module",
  "scripts": {
    "build": "vite build --config ../example-vite.config.ts",
    "clean:dist": "rimraf ./dist",
    "develop": "vite --config ../example-vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test  --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start-test-server:prod": "vite serve dist/prod --port 9050"
  },
  "dependencies": {
    "@ai-sdk/azure": "catalog:",
    "@tomtom-org/maps-sdk": "catalog:",
    "@tomtom-org/maps-sdk-plugin-agent-toolkit": "catalog:",
    "ai": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
