{
  "entryPoints": ["./core/index.ts", "./map/index.ts", "./services/index.ts", "./plugins/index.ts"],
  "out": "documentation/docs-portal/api-reference",
  "readme": "none",
  "name": "TomTom Maps for JavaScript",
  "exclude": ["**/*.test.ts"],
  "skipErrorChecking": true,
  "compilerOptions": {
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "externalSymbolLinkMappings": {
    "maplibre-gl": {
      "Map": "https://maplibre.org/maplibre-gl-js/docs/API/classes/Map/",
      "MapOptions": "https://maplibre.org/maplibre-gl-js/docs/API/type-aliases/MapOptions/",
      "*": "https://maplibre.org/maplibre-gl-js/docs/API/"
    },
    "@types/geojson": {
      "*": "https://github.com/DefinitelyTyped/DefinitelyTyped/blob/master/types/geojson/index.d.ts"
    }
  },
  "githubPages": false,
  "disableSources": true,
  "navigation": {
    "includeGroups": true,
    "compactFolders": false
  }
}
